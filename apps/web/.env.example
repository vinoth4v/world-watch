# Copy to .env.local and fill in. Never commit .env.local.

# Neon connection string (pooled). Neon dashboard -> Connection Details.
DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Only present when the app was scaffolded with --with-s3. Werft mints these:
# a bucket and a bucket-scoped IAM user, so this key can touch this bucket and
# nothing else. Never the AWS admin key.
# S3_BUCKET=""
# AWS_REGION=""
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
